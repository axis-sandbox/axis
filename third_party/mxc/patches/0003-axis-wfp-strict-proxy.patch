+/// Remove caller-controlled proxy variables and inject only the AXIS endpoint
+/// represented by the same strict WFP lease request.
+fn strict_proxy_environment(request: &ExecutionRequest) -> Vec<String> {
+    const PROXY_KEYS: &[&str] = &["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY"];
+    let mut env = request
+        .env
+        .iter()
+        .filter(|entry| {
+            entry.split_once('=').is_none_or(|(key, _)| {
+                !PROXY_KEYS.iter().any(|name| key.eq_ignore_ascii_case(name))
+            })
+        })
+        .cloned()
+        .collect::<Vec<_>>();
+    if let Some(proxy) = request.policy.network_proxy.address.as_ref() {
+        let url = proxy.to_url();
+        env.push(format!("HTTP_PROXY={url}"));
+        env.push(format!("HTTPS_PROXY={url}"));
+    }
+    env
+}
